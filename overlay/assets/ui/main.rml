<rml>
    <head>
        <title>Prospero Radio Vulkan</title>
        <link type="text/rcss" href="styles/app.rcss" />
        <link type="text/rcss" href="styles/controls.rcss" />
    </head>
    <body>
        <div id="app-shell">
            <img id="radio-backdrop" src="art/radio_front_hybrid_4k.ktx2" alt="" />
            <img id="radio-cd-stack-overlay" class="hidden" alt="" />

            <div id="controls-layer">
                <div id="volume-frame" class="volume-frame volume-frame-20"></div>
                <div id="tuner-frame" class="tuner-frame tuner-idle"></div>
                <div id="btn-home" class="btn-overlay btn-home btn-home-normal"></div>
                <div id="btn-radio" class="btn-overlay btn-radio btn-radio-selected"></div>
                <div id="btn-favorites" class="btn-overlay btn-favorites btn-favorites-normal"></div>
                <div id="btn-genres" class="btn-overlay btn-genres btn-genres-normal"></div>
                <div id="btn-search" class="btn-overlay btn-search btn-search-normal"></div>
                <div id="btn-settings" class="btn-overlay btn-settings btn-settings-normal"></div>
                <div id="btn-play-pause" class="btn-overlay btn-play-pause btn-play-pause-normal"></div>
            </div>

            <div id="display">
                <div id="screen-home">
                    <span id="home-kicker">NOW PLAYING  /  __PROSPERO_VERSION__</span>
                    <span id="home-name">Tuning...</span>
                    <span id="home-meta">Turn the TUNING dial to find a station</span>
                    <span id="home-status">READY</span>
                    <span id="chip-p0" class="chip chip-off">P1</span>
                    <span id="chip-p1" class="chip chip-off">P2</span>
                    <span id="chip-p2" class="chip chip-off">P3</span>
                    <div id="eq">
                        <span id="eq-0" class="eq-bar"></span>
                        <span id="eq-1" class="eq-bar"></span>
                        <span id="eq-2" class="eq-bar"></span>
                        <span id="eq-3" class="eq-bar"></span>
                        <span id="eq-4" class="eq-bar"></span>
                    </div>
                    <span id="volume-level">VOL 100%</span>
                    <span id="home-hint">CROSS: press  |  DIAL: tune  |  SQUARE: favorite</span>
                </div>

                <div id="screen-list" class="hidden">
                    <span id="list-title">RADIO BROWSER</span>
                    <div id="list-tabs">
                        <span id="list-tab-radio" class="list-tab">RADIO</span>
                        <span id="list-tab-favorites" class="list-tab">FAVORITOS</span>
                        <span id="list-tab-aux" class="list-tab">AUX</span>
                        <span id="list-tab-usb" class="list-tab">USB</span>
                    </div>
                    <div id="list-row-0" class="list-row"><span class="list-cursor">&#9654;</span><span id="list-name-0" class="list-name"></span><span id="list-meta-0" class="list-meta"></span><span id="list-fav-0" class="list-fav">&#9733;</span><span id="list-delete-countdown-0" class="list-delete-countdown hidden"></span></div>
                    <div id="list-row-1" class="list-row"><span class="list-cursor">&#9654;</span><span id="list-name-1" class="list-name"></span><span id="list-meta-1" class="list-meta"></span><span id="list-fav-1" class="list-fav">&#9733;</span><span id="list-delete-countdown-1" class="list-delete-countdown hidden"></span></div>
                    <div id="list-row-2" class="list-row"><span class="list-cursor">&#9654;</span><span id="list-name-2" class="list-name"></span><span id="list-meta-2" class="list-meta"></span><span id="list-fav-2" class="list-fav">&#9733;</span><span id="list-delete-countdown-2" class="list-delete-countdown hidden"></span></div>
                    <div id="list-row-3" class="list-row"><span class="list-cursor">&#9654;</span><span id="list-name-3" class="list-name"></span><span id="list-meta-3" class="list-meta"></span><span id="list-fav-3" class="list-fav">&#9733;</span><span id="list-delete-countdown-3" class="list-delete-countdown hidden"></span></div>
                    <div id="list-row-4" class="list-row"><span class="list-cursor">&#9654;</span><span id="list-name-4" class="list-name"></span><span id="list-meta-4" class="list-meta"></span><span id="list-fav-4" class="list-fav">&#9733;</span><span id="list-delete-countdown-4" class="list-delete-countdown hidden"></span></div>
                    <div id="list-row-5" class="list-row"><span class="list-cursor">&#9654;</span><span id="list-name-5" class="list-name"></span><span id="list-meta-5" class="list-meta"></span><span id="list-fav-5" class="list-fav">&#9733;</span><span id="list-delete-countdown-5" class="list-delete-countdown hidden"></span></div>
                    <div id="list-row-6" class="list-row"><span class="list-cursor">&#9654;</span><span id="list-name-6" class="list-name"></span><span id="list-meta-6" class="list-meta"></span><span id="list-fav-6" class="list-fav">&#9733;</span><span id="list-delete-countdown-6" class="list-delete-countdown hidden"></span></div>
                    <span id="list-status">0 / 0 STATIONS</span>
                </div>

                <div id="screen-genres" class="hidden">
                    <span id="genres-title">GENRES</span>
                    <div id="genre-row-0" class="list-row"><span class="list-cursor">&#9654;</span><span id="genre-name-0" class="list-name"></span><span id="genre-count-0" class="list-count"></span></div>
                    <div id="genre-row-1" class="list-row"><span class="list-cursor">&#9654;</span><span id="genre-name-1" class="list-name"></span><span id="genre-count-1" class="list-count"></span></div>
                    <div id="genre-row-2" class="list-row"><span class="list-cursor">&#9654;</span><span id="genre-name-2" class="list-name"></span><span id="genre-count-2" class="list-count"></span></div>
                    <div id="genre-row-3" class="list-row"><span class="list-cursor">&#9654;</span><span id="genre-name-3" class="list-name"></span><span id="genre-count-3" class="list-count"></span></div>
                    <div id="genre-row-4" class="list-row"><span class="list-cursor">&#9654;</span><span id="genre-name-4" class="list-name"></span><span id="genre-count-4" class="list-count"></span></div>
                    <div id="genre-row-5" class="list-row"><span class="list-cursor">&#9654;</span><span id="genre-name-5" class="list-name"></span><span id="genre-count-5" class="list-count"></span></div>
                    <div id="genre-row-6" class="list-row"><span class="list-cursor">&#9654;</span><span id="genre-name-6" class="list-name"></span><span id="genre-count-6" class="list-count"></span></div>
                    <span id="genres-status">0 GENRES</span>
                </div>

                <div id="screen-aux" class="hidden">
                <span class="panel-kicker">ENTRADA AUXILIAR</span>
                <span class="panel-big" id="aux-url">PUERTO 7000</span>
                <span class="panel-note" id="aux-note">Elige el archivo .m3u desde tu movil o PC</span>
            </div>
            <div id="screen-barrido" class="hidden">
                <span class="panel-kicker">BARRIDO DE LISTAS</span>
                <span class="panel-big" id="barrido-status">SIN LISTAS NUEVAS</span>
                <span class="panel-note">Cross: abrir lista importada | Circle: volver</span>
            </div>
            <div id="screen-eq" class="hidden">
                <span class="panel-kicker">ECUALIZADOR · FRECUENCIAS EN Hz / kHz</span>
                <div id="eqband-0" class="eq-control eqband"><span class="eq-label">60</span><div class="eq-track"><div class="eq-zero"></div><div id="eqfill-0" class="eq-fill"></div></div><span id="eqgain-0" class="eq-value">0dB</span></div>
                <div id="eqband-1" class="eq-control eqband"><span class="eq-label">125</span><div class="eq-track"><div class="eq-zero"></div><div id="eqfill-1" class="eq-fill"></div></div><span id="eqgain-1" class="eq-value">0dB</span></div>
                <div id="eqband-2" class="eq-control eqband"><span class="eq-label">250</span><div class="eq-track"><div class="eq-zero"></div><div id="eqfill-2" class="eq-fill"></div></div><span id="eqgain-2" class="eq-value">0dB</span></div>
                <div id="eqband-3" class="eq-control eqband"><span class="eq-label">500</span><div class="eq-track"><div class="eq-zero"></div><div id="eqfill-3" class="eq-fill"></div></div><span id="eqgain-3" class="eq-value">0dB</span></div>
                <div id="eqband-4" class="eq-control eqband"><span class="eq-label">1k</span><div class="eq-track"><div class="eq-zero"></div><div id="eqfill-4" class="eq-fill"></div></div><span id="eqgain-4" class="eq-value">0dB</span></div>
                <div id="eqband-5" class="eq-control eqband"><span class="eq-label">1.5k</span><div class="eq-track"><div class="eq-zero"></div><div id="eqfill-5" class="eq-fill"></div></div><span id="eqgain-5" class="eq-value">0dB</span></div>
                <div id="eqband-6" class="eq-control eqband"><span class="eq-label">2k</span><div class="eq-track"><div class="eq-zero"></div><div id="eqfill-6" class="eq-fill"></div></div><span id="eqgain-6" class="eq-value">0dB</span></div>
                <div id="eqband-7" class="eq-control eqband"><span class="eq-label">3k</span><div class="eq-track"><div class="eq-zero"></div><div id="eqfill-7" class="eq-fill"></div></div><span id="eqgain-7" class="eq-value">0dB</span></div>
                <div id="eqband-8" class="eq-control eqband"><span class="eq-label">4k</span><div class="eq-track"><div class="eq-zero"></div><div id="eqfill-8" class="eq-fill"></div></div><span id="eqgain-8" class="eq-value">0dB</span></div>
                <div id="eqband-9" class="eq-control eqband"><span class="eq-label">6k</span><div class="eq-track"><div class="eq-zero"></div><div id="eqfill-9" class="eq-fill"></div></div><span id="eqgain-9" class="eq-value">0dB</span></div>
                <div id="eqband-10" class="eq-control eqband"><span class="eq-label">8k</span><div class="eq-track"><div class="eq-zero"></div><div id="eqfill-10" class="eq-fill"></div></div><span id="eqgain-10" class="eq-value">0dB</span></div>
                <div id="eqband-11" class="eq-control eqband"><span class="eq-label">12k</span><div class="eq-track"><div class="eq-zero"></div><div id="eqfill-11" class="eq-fill"></div></div><span id="eqgain-11" class="eq-value">0dB</span></div>
                <div id="eqband-12" class="eq-control eqband eq-channel"><span class="eq-label">L</span><div class="eq-track"><div class="eq-zero"></div><div id="eqfill-12" class="eq-fill"></div></div><span id="eqgain-12" class="eq-value">0dB</span></div>
                <div id="eqband-13" class="eq-control eqband eq-channel"><span class="eq-label">R</span><div class="eq-track"><div class="eq-zero"></div><div id="eqfill-13" class="eq-fill"></div></div><span id="eqgain-13" class="eq-value">0dB</span></div>
                <span class="panel-note" id="eq-help">Dcho: bandas &gt; L &gt; R  |  Izq: +/-12 dB  |  X: preset  |  Triángulo: volver</span>
            </div>
                <div id="search-panel" class="hidden">
                    <span class="search-kicker">PROSPERO RADIO  /  SEARCH</span>
                    <span class="search-title">Find stations</span>
                    <button id="search-query" class="search-action search-query-button">
                        <span id="search-query-label" class="search-query-label">Press Cross to type a station or genre...</span>
                    </button>
                    <button id="filter-1" class="search-action filter-1">
                        <span id="filter-label-1" class="search-action-title">GENRE  /  All genres</span>
                    </button>
                    <button id="filter-3" class="search-action filter-3">
                        <span id="filter-label-3" class="search-action-title">QUALITY  /  Any bitrate</span>
                    </button>
                    <button id="search-apply" class="search-action search-apply">
                        <span class="search-action-title">Show stations</span>
                    </button>
                    <span class="search-controls">Cross: edit / cycle  |  Up / Down: move  |  Circle: back</span>
                </div>
            </div>

            <div id="cd-interface" class="hidden sleeping">
                <div id="cd-panel">
                    <span id="cd-list-title">PROSPERO CD</span>
                    <span id="cd-list-status">WAITING FOR READER</span>
                    <div id="cd-track-list">
                        <div id="cd-track-0" class="cd-track-row"><span class="cd-track-mark">▶</span><span id="cd-track-name-0" class="cd-track-name"></span><span id="cd-track-kind-0" class="cd-track-kind"></span></div>
                        <div id="cd-track-1" class="cd-track-row"><span class="cd-track-mark">▶</span><span id="cd-track-name-1" class="cd-track-name"></span><span id="cd-track-kind-1" class="cd-track-kind"></span></div>
                        <div id="cd-track-2" class="cd-track-row"><span class="cd-track-mark">▶</span><span id="cd-track-name-2" class="cd-track-name"></span><span id="cd-track-kind-2" class="cd-track-kind"></span></div>
                        <div id="cd-track-3" class="cd-track-row"><span class="cd-track-mark">▶</span><span id="cd-track-name-3" class="cd-track-name"></span><span id="cd-track-kind-3" class="cd-track-kind"></span></div>
                        <div id="cd-track-4" class="cd-track-row"><span class="cd-track-mark">▶</span><span id="cd-track-name-4" class="cd-track-name"></span><span id="cd-track-kind-4" class="cd-track-kind"></span></div>
                    </div>
                    <div id="cd-status-panel">
                        <span id="cd-player-status">READER READY</span>
                        <span id="cd-now-title">INSERT AN AUDIO CD</span>
                        <span id="cd-now-meta">CD-DA · CD-MP3</span>
                        <div id="cd-disc-viewport">
                            <img id="cd-disc-icon-00" class="cd-disc-icon hidden" alt="" />
                            <img id="cd-disc-icon-01" class="cd-disc-icon hidden" alt="" />
                            <img id="cd-disc-icon-02" class="cd-disc-icon hidden" alt="" />
                            <img id="cd-disc-icon-03" class="cd-disc-icon hidden" alt="" />
                            <img id="cd-disc-icon-04" class="cd-disc-icon hidden" alt="" />
                            <img id="cd-disc-icon-05" class="cd-disc-icon hidden" alt="" />
                            <img id="cd-disc-icon-06" class="cd-disc-icon hidden" alt="" />
                            <img id="cd-disc-icon-07" class="cd-disc-icon hidden" alt="" />
                            <img id="cd-disc-icon-08" class="cd-disc-icon hidden" alt="" />
                            <img id="cd-disc-icon-09" class="cd-disc-icon hidden" alt="" />
                            <img id="cd-disc-icon-10" class="cd-disc-icon hidden" alt="" />
                            <img id="cd-disc-icon-11" class="cd-disc-icon hidden" alt="" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </body>
</rml>
