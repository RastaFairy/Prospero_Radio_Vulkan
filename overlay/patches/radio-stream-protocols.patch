+    {
+        const int amount = sceHttpReadData(request, response + received, sizeof(response) - received);
+        if (amount < 0)
+        {
+            hls_secure_zero(response, sizeof(response));
+            received = 0U;
+            break;
+        }
+        if (amount == 0)
