<rml>
    <head>
        <title>ProsperoRadio</title>
        <link type="text/rcss" href="styles/app.rcss" />
        <link type="text/rcss" href="styles/controls.rcss" />
    </head>
    <body>
        <div id="app-shell">
            <img id="radio-backdrop" src="art/radio_front_hybrid_4k.ktx2" alt="" />

            <div id="controls-layer">
    <img id="volume_frame_00" class="volume-frame-img frame-img hidden" src="controls/frames/volume_frame_00.tga" />
    <img id="volume_frame_01" class="volume-frame-img frame-img hidden" src="controls/frames/volume_frame_01.tga" />
    <img id="volume_frame_02" class="volume-frame-img frame-img hidden" src="controls/frames/volume_frame_02.tga" />
    <img id="volume_frame_03" class="volume-frame-img frame-img hidden" src="controls/frames/volume_frame_03.tga" />
    <img id="volume_frame_04" class="volume-frame-img frame-img hidden" src="controls/frames/volume_frame_04.tga" />
    <img id="volume_frame_05" class="volume-frame-img frame-img hidden" src="controls/frames/volume_frame_05.tga" />
    <img id="volume_frame_06" class="volume-frame-img frame-img hidden" src="controls/frames/volume_frame_06.tga" />
    <img id="volume_frame_07" class="volume-frame-img frame-img hidden" src="controls/frames/volume_frame_07.tga" />
    <img id="volume_frame_08" class="volume-frame-img frame-img hidden" src="controls/frames/volume_frame_08.tga" />
    <img id="volume_frame_09" class="volume-frame-img frame-img hidden" src="controls/frames/volume_frame_09.tga" />
    <img id="volume_frame_10" class="volume-frame-img frame-img hidden" src="controls/frames/volume_frame_10.tga" />
    <img id="volume_frame_11" class="volume-frame-img frame-img hidden" src="controls/frames/volume_frame_11.tga" />
    <img id="volume_frame_12" class="volume-frame-img frame-img hidden" src="controls/frames/volume_frame_12.tga" />
    <img id="volume_frame_13" class="volume-frame-img frame-img hidden" src="controls/frames/volume_frame_13.tga" />
    <img id="volume_frame_14" class="volume-frame-img frame-img hidden" src="controls/frames/volume_frame_14.tga" />
    <img id="volume_frame_15" class="volume-frame-img frame-img hidden" src="controls/frames/volume_frame_15.tga" />
    <img id="volume_frame_16" class="volume-frame-img frame-img hidden" src="controls/frames/volume_frame_16.tga" />
    <img id="volume_frame_17" class="volume-frame-img frame-img hidden" src="controls/frames/volume_frame_17.tga" />
    <img id="volume_frame_18" class="volume-frame-img frame-img hidden" src="controls/frames/volume_frame_18.tga" />
    <img id="volume_frame_19" class="volume-frame-img frame-img hidden" src="controls/frames/volume_frame_19.tga" />
    <img id="volume_frame_20" class="volume-frame-img frame-img" src="controls/frames/volume_frame_20.tga" />
    <img id="volume_focus_ring" class="volume-frame-img frame-img hidden" src="controls/frames/volume_focus_ring.tga" />
    <img id="tuner_idle" class="tuner-frame-img frame-img" src="controls/frames/tuner_idle.tga" />
    <img id="tuner_previous_focus" class="tuner-frame-img frame-img hidden" src="controls/frames/tuner_previous_focus.tga" />
    <img id="tuner_previous_pressed" class="tuner-frame-img frame-img hidden" src="controls/frames/tuner_previous_pressed.tga" />
    <img id="tuner_next_focus" class="tuner-frame-img frame-img hidden" src="controls/frames/tuner_next_focus.tga" />
    <img id="tuner_next_pressed" class="tuner-frame-img frame-img hidden" src="controls/frames/tuner_next_pressed.tga" />
    <img id="btn-home-normal" class="btn-img btn-rect-home frame-img" src="controls/frames/btn_home_normal.tga" />
    <img id="btn-home-focus" class="btn-img btn-rect-home frame-img hidden" src="controls/frames/btn_home_focus.tga" />
    <img id="btn-home-pressed" class="btn-img btn-rect-home frame-img hidden" src="controls/frames/btn_home_pressed.tga" />
    <img id="btn-home-selected" class="btn-img btn-rect-home frame-img hidden" src="controls/frames/btn_home_selected.tga" />
    <img id="btn-home-selected_focus" class="btn-img btn-rect-home frame-img hidden" src="controls/frames/btn_home_selected_focus.tga" />
    <img id="btn-radio-normal" class="btn-img btn-rect-radio frame-img" src="controls/frames/btn_radio_normal.tga" />
    <img id="btn-radio-focus" class="btn-img btn-rect-radio frame-img hidden" src="controls/frames/btn_radio_focus.tga" />
    <img id="btn-radio-pressed" class="btn-img btn-rect-radio frame-img hidden" src="controls/frames/btn_radio_pressed.tga" />
    <img id="btn-radio-selected" class="btn-img btn-rect-radio frame-img selected" src="controls/frames/btn_radio_selected.tga" />
    <img id="btn-radio-selected_focus" class="btn-img btn-rect-radio frame-img hidden" src="controls/frames/btn_radio_selected_focus.tga" />
    <img id="btn-favorites-normal" class="btn-img btn-rect-favorites frame-img" src="controls/frames/btn_favorites_normal.tga" />
    <img id="btn-favorites-focus" class="btn-img btn-rect-favorites frame-img hidden" src="controls/frames/btn_favorites_focus.tga" />
    <img id="btn-favorites-pressed" class="btn-img btn-rect-favorites frame-img hidden" src="controls/frames/btn_favorites_pressed.tga" />
    <img id="btn-favorites-selected" class="btn-img btn-rect-favorites frame-img hidden" src="controls/frames/btn_favorites_selected.tga" />
    <img id="btn-favorites-selected_focus" class="btn-img btn-rect-favorites frame-img hidden" src="controls/frames/btn_favorites_selected_focus.tga" />
    <img id="btn-genres-normal" class="btn-img btn-rect-genres frame-img" src="controls/frames/btn_genres_normal.tga" />
    <img id="btn-genres-focus" class="btn-img btn-rect-genres frame-img hidden" src="controls/frames/btn_genres_focus.tga" />
    <img id="btn-genres-pressed" class="btn-img btn-rect-genres frame-img hidden" src="controls/frames/btn_genres_pressed.tga" />
    <img id="btn-genres-selected" class="btn-img btn-rect-genres frame-img hidden" src="controls/frames/btn_genres_selected.tga" />
    <img id="btn-genres-selected_focus" class="btn-img btn-rect-genres frame-img hidden" src="controls/frames/btn_genres_selected_focus.tga" />
    <img id="btn-search-normal" class="btn-img btn-rect-search frame-img" src="controls/frames/btn_search_normal.tga" />
    <img id="btn-search-focus" class="btn-img btn-rect-search frame-img hidden" src="controls/frames/btn_search_focus.tga" />
    <img id="btn-search-pressed" class="btn-img btn-rect-search frame-img hidden" src="controls/frames/btn_search_pressed.tga" />
    <img id="btn-search-selected" class="btn-img btn-rect-search frame-img hidden" src="controls/frames/btn_search_selected.tga" />
    <img id="btn-search-selected_focus" class="btn-img btn-rect-search frame-img hidden" src="controls/frames/btn_search_selected_focus.tga" />
    <img id="btn-settings-normal" class="btn-img btn-rect-settings frame-img" src="controls/frames/btn_settings_normal.tga" />
    <img id="btn-settings-focus" class="btn-img btn-rect-settings frame-img hidden" src="controls/frames/btn_settings_focus.tga" />
    <img id="btn-settings-pressed" class="btn-img btn-rect-settings frame-img hidden" src="controls/frames/btn_settings_pressed.tga" />
    <img id="btn-settings-selected" class="btn-img btn-rect-settings frame-img hidden" src="controls/frames/btn_settings_selected.tga" />
    <img id="btn-settings-selected_focus" class="btn-img btn-rect-settings frame-img hidden" src="controls/frames/btn_settings_selected_focus.tga" />
    <img id="btn-play-pause-normal" class="btn-img btn-rect-play-pause frame-img" src="controls/frames/btn_play_pause_normal.tga" />
    <img id="btn-play-pause-focus" class="btn-img btn-rect-play-pause frame-img hidden" src="controls/frames/btn_play_pause_focus.tga" />
    <img id="btn-play-pause-pressed" class="btn-img btn-rect-play-pause frame-img hidden" src="controls/frames/btn_play_pause_pressed.tga" />
    <img id="btn-play-pause-selected" class="btn-img btn-rect-play-pause frame-img hidden" src="controls/frames/btn_play_pause_selected.tga" />
    <img id="btn-play-pause-selected_focus" class="btn-img btn-rect-play-pause frame-img hidden" src="controls/frames/btn_play_pause_selected_focus.tga" />
</div>

<div id="display">
                <div id="screen-home">
                    <span id="home-kicker">NOW PLAYING  /  01.000.028</span>
                    <span id="home-name">Tuning...</span>
                    <span id="home-meta">Turn the TUNING dial to find a station</span>
                    <span id="home-status">READY</span>
                    <span id="chip-p0" class="chip chip-off">P1</span>
                    <span id="chip-p1" class="chip chip-off">P2</span>
                    <span id="chip-p2" class="chip chip-off">P3</span>
                    <div id="eq">
                        <span id="eq-0" class="eq-bar"></span>
                        <span id="eq-1" class="eq-bar"></span>
                        <span id="eq-2" class="eq-bar"></span>
                        <span id="eq-3" class="eq-bar"></span>
                        <span id="eq-4" class="eq-bar"></span>
                    </div>
                    <span id="volume-level">VOL 100%</span>
                    <span id="home-hint">CROSS: press  |  DIAL: tune  |  SQUARE: favorite</span>
                </div>

                <div id="screen-list" class="hidden">
                    <span id="list-title">RADIO BROWSER</span>
                    <div id="list-row-0" class="list-row"><span class="list-cursor">&#9654;</span><span id="list-name-0" class="list-name"></span><span id="list-meta-0" class="list-meta"></span><span id="list-fav-0" class="list-fav">&#9733;</span></div>
                    <div id="list-row-1" class="list-row"><span class="list-cursor">&#9654;</span><span id="list-name-1" class="list-name"></span><span id="list-meta-1" class="list-meta"></span><span id="list-fav-1" class="list-fav">&#9733;</span></div>
                    <div id="list-row-2" class="list-row"><span class="list-cursor">&#9654;</span><span id="list-name-2" class="list-name"></span><span id="list-meta-2" class="list-meta"></span><span id="list-fav-2" class="list-fav">&#9733;</span></div>
                    <div id="list-row-3" class="list-row"><span class="list-cursor">&#9654;</span><span id="list-name-3" class="list-name"></span><span id="list-meta-3" class="list-meta"></span><span id="list-fav-3" class="list-fav">&#9733;</span></div>
                    <div id="list-row-4" class="list-row"><span class="list-cursor">&#9654;</span><span id="list-name-4" class="list-name"></span><span id="list-meta-4" class="list-meta"></span><span id="list-fav-4" class="list-fav">&#9733;</span></div>
                    <div id="list-row-5" class="list-row"><span class="list-cursor">&#9654;</span><span id="list-name-5" class="list-name"></span><span id="list-meta-5" class="list-meta"></span><span id="list-fav-5" class="list-fav">&#9733;</span></div>
                    <div id="list-row-6" class="list-row"><span class="list-cursor">&#9654;</span><span id="list-name-6" class="list-name"></span><span id="list-meta-6" class="list-meta"></span><span id="list-fav-6" class="list-fav">&#9733;</span></div>
                    <span id="list-status">0 / 0 STATIONS</span>
                </div>

                <div id="screen-genres" class="hidden">
                    <span id="genres-title">GENRES</span>
                    <div id="genre-row-0" class="list-row"><span class="list-cursor">&#9654;</span><span id="genre-name-0" class="list-name"></span><span id="genre-count-0" class="list-count"></span></div>
                    <div id="genre-row-1" class="list-row"><span class="list-cursor">&#9654;</span><span id="genre-name-1" class="list-name"></span><span id="genre-count-1" class="list-count"></span></div>
                    <div id="genre-row-2" class="list-row"><span class="list-cursor">&#9654;</span><span id="genre-name-2" class="list-name"></span><span id="genre-count-2" class="list-count"></span></div>
                    <div id="genre-row-3" class="list-row"><span class="list-cursor">&#9654;</span><span id="genre-name-3" class="list-name"></span><span id="genre-count-3" class="list-count"></span></div>
                    <div id="genre-row-4" class="list-row"><span class="list-cursor">&#9654;</span><span id="genre-name-4" class="list-name"></span><span id="genre-count-4" class="list-count"></span></div>
                    <div id="genre-row-5" class="list-row"><span class="list-cursor">&#9654;</span><span id="genre-name-5" class="list-name"></span><span id="genre-count-5" class="list-count"></span></div>
                    <div id="genre-row-6" class="list-row"><span class="list-cursor">&#9654;</span><span id="genre-name-6" class="list-name"></span><span id="genre-count-6" class="list-count"></span></div>
                    <span id="genres-status">0 GENRES</span>
                </div>

                <div id="screen-aux" class="hidden">
                <span class="panel-kicker">ENTRADA AUXILIAR</span>
                <span class="panel-big" id="aux-url">PUERTO 7000</span>
                <span class="panel-note" id="aux-note">Sube tu lista M3U desde el movil o el PC</span>
            </div>
            <div id="screen-barrido" class="hidden">
                <span class="panel-kicker">BARRIDO DE LISTAS</span>
                <span class="panel-big" id="barrido-status">SIN LISTAS NUEVAS</span>
                <span class="panel-note">La ingesta completa de listas llega en v027</span>
            </div>
            <div id="screen-eq" class="hidden">
                <span class="panel-kicker">ECUALIZADOR</span>
                <span id="eqband-0" class="eqband">60Hz 0</span>
                <span id="eqband-1" class="eqband">250Hz 0</span>
                <span id="eqband-2" class="eqband">1kHz 0</span>
                <span id="eqband-3" class="eqband">4kHz 0</span>
                <span id="eqband-4" class="eqband">12kHz 0</span>
                <span class="panel-note">dial dcho: banda - dial izq: ganancia - X preset - triangulo volver</span>
            </div>
            <div id="settings-panel" class="hidden">
                    <span class="settings-kicker">PROSPERO RADIO  /  SETTINGS</span>
                    <span class="settings-title">Radio settings</span>

                    <div id="settings-theme-row" class="settings-theme-row">
                        <span class="settings-theme-label">CABINET FINISH</span>
                        <span id="settings-theme-value" class="settings-theme-value">Walnut</span>
                        <span class="settings-theme-help">Left / right: select, Cross applies</span>
                    </div>

                    <div id="settings-volume-row" class="settings-volume-row">
                        <span class="settings-volume-label">OUTPUT VOLUME</span>
                        <span id="settings-volume-value" class="settings-volume-value">100%</span>
                        <span class="settings-volume-meter"><span id="settings-volume-fill"></span></span>
                        <span class="settings-volume-help">Rotate left stick</span>
                    </div>

                    <button id="settings-favorites" class="settings-action settings-favorites">
                        <span class="settings-action-title">Open favorites</span>
                        <span id="settings-favorites-count" class="settings-action-detail">0 saved stations</span>
                    </button>
                    <button id="settings-refresh" class="settings-action settings-refresh">
                        <span class="settings-action-title">Update station lists</span>
                        <span id="settings-refresh-state" class="settings-action-detail">Ready</span>
                    </button>

                    <span class="settings-controls">Cross: press  |  D-pad: move  |  Circle: back</span>
                </div>

                <div id="search-panel" class="hidden">
                    <span class="settings-kicker">PROSPERO RADIO  /  SEARCH</span>
                    <span class="settings-title">Find stations</span>
                    <button id="search-query" class="settings-action search-query-button">
                        <span id="search-query-label" class="search-query-label">Press Cross to type a station or genre...</span>
                    </button>
                    <button id="filter-1" class="settings-action filter-1">
                        <span id="filter-label-1" class="settings-action-title">GENRE  /  All genres</span>
                    </button>
                    <button id="filter-3" class="settings-action filter-3">
                        <span id="filter-label-3" class="settings-action-title">QUALITY  /  Any bitrate</span>
                    </button>
                    <button id="search-apply" class="settings-action search-apply">
                        <span class="settings-action-title">Show stations</span>
                    </button>
                    <span class="settings-controls">Cross: edit / cycle  |  Up / Down: move  |  Circle: back</span>
                </div>
            </div>
        </div>
    </body>
</rml>
